# ---------------------------------------------------------------------------
# CoWork LLM 설정
# 사용법: 이 파일을 `.env`로 복사 후 본인 환경에 맞게 수정.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# provider 선택: ollama | openai
#   ollama  → 로컬 Ollama 서버 (집/외부)
#   openai  → OpenAI 호환 사내 LLM gateway
LLM_PROVIDER=ollama

# ---------- ollama (로컬) ----------
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=qwen2.5-coder:7b
# LLM_VISION_MODEL=gemma4:e4b

# ---------- openai 호환 (사내) ----------
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://internal-llm.company.com/v1
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=gpt-oss-120b
# LLM_VISION_MODEL=gemma-4-31B-it

# 공통 옵션
# LLM_TIMEOUT=300
# LLM_VERIFY_SSL=true     # 사내 자체서명 인증서 이슈 시 false
